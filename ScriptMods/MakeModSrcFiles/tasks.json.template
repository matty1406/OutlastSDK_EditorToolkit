{
    // Build tasks for the __MODNAME__ mod package.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile __MODNAME__",
            "type": "shell",
            "command": "${workspaceFolder}/Compile.bat",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Compile __MODNAME__ (retail format)",
            "type": "shell",
            "command": "${workspaceFolder}/CompileRetail.bat",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Deploy __MODNAME__",
            "type": "shell",
            "command": "${workspaceFolder}/Deploy.bat",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}