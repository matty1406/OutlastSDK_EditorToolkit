@echo off
setlocal
set ModName=__MODNAME__
set EngineRoot=%~dp0..\..\..

rem These scripts find the engine by climbing out of Development\Src\__MODNAME__, so
rem they only work from where MakeMod.bat put them. Say so plainly rather than
rem letting cmd fail with "The system cannot find the path specified".
if not exist "%EngineRoot%\Binaries\Win64\OLGame.com" (
    echo This script has to stay in Development\Src\%ModName%\ inside the engine tree.
    echo Looked for the engine at: %EngineRoot%
    exit /b 1
)

rem A mod with a manifest needs an Id, Name, Version and Author, and the Id must be
rem namespaced by the Author. Check before cooking, so that costs a second here rather
rem than a .u that compiles fine and then does not appear in the launcher.
rem Exit 2 means there is no manifest at all, which is fine for a non-SDK mod.
set NoManifest=
powershell -NoProfile -ExecutionPolicy Bypass -File "%EngineRoot%\MakeModSrcFiles\Check-ModManifest.ps1" -File "%~dp0Classes"
if ERRORLEVEL 2 (
    set NoManifest=1
) else if ERRORLEVEL 1 (
    exit /b 1
)

echo ----------------------------------
echo -Compiling Scripts (retail format)-
echo ----------------------------------
echo.
echo %ModName%.u will be stamped 867 / 3 / engine 10907 so retail Outlast accepts it.
echo Every other package keeps normal engine versioning.
echo.

rem The retail stamp is applied when the package is WRITTEN, so a package that make
rem considers up to date would keep its old stamp. Delete it first to force a rebuild.
if exist "%EngineRoot%\OLGame\Script\%ModName%.u" del "%EngineRoot%\OLGame\Script\%ModName%.u"

"%EngineRoot%\Binaries\Win64\OLGame.com" make -auto -NOPAUSEONSUCCESS -SaveAsRetail=%ModName%

if ERRORLEVEL 1 (
    echo.
    echo Failed to compile %ModName%.
    exit /b 1
)

echo.
echo %ModName% compiled to OLGame\Script\%ModName%.u in retail format.

if defined NoManifest (
    echo.
    echo Note: %ModName% has no SDKModManifest class, so it was built as a plain script package.
    echo That is fine for non-SDK mods, but the OutlastSDK needs a manifest to list and load a mod.
)