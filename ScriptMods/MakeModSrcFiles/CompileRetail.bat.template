@echo off
rem Run the real work below as a nested call, then say plainly whether it worked and
rem wait for a key, so a double-clicked window does not close before you can read it.
rem The VS Code tasks pass nopause, and the VS Code terminal never pauses.
if "%OLSDK_INNER%"=="1" goto :Main
setlocal
set OLSDK_INNER=1
set NoPause=
if /i "%TERM_PROGRAM%"=="vscode" set NoPause=1
for %%a in (%*) do if /i "%%~a"=="nopause" set NoPause=1
call "%~f0" %*
set Result=%ERRORLEVEL%
echo.
if "%Result%"=="0" (
    powershell -NoProfile -Command "Write-Host '==== __MODNAME__ retail compile SUCCEEDED ====' -ForegroundColor Green"
) else (
    powershell -NoProfile -Command "Write-Host '==== __MODNAME__ retail compile FAILED, see the messages above ====' -ForegroundColor Red"
)
if not defined NoPause pause
exit /b %Result%

:Main
setlocal
set ModName=__MODNAME__
rem The engine is three folders up. Resolving it keeps the messages free of ..\ steps.
for %%i in ("%~dp0..\..\..") do set "EngineRoot=%%~fi"
set "UPath=%EngineRoot%\OLGame\Script\%ModName%.u"

rem These scripts find the engine by climbing out of Development\Src\__MODNAME__, so
rem they only work from where MakeMod.bat put them. Say so plainly rather than
rem letting cmd fail with "The system cannot find the path specified".
if not exist "%EngineRoot%\Binaries\Win64\OLGame.com" (
    echo This script has to stay in Development\Src\%ModName%\ inside the engine tree.
    echo Looked for the engine at: %EngineRoot%
    exit /b 1
)

echo ----------------------------------
echo -Compiling Scripts (retail format)-
echo ----------------------------------
echo Mod:    %ModName%
echo Engine: %EngineRoot%
echo.
echo %ModName%.u will be stamped 868 / 3 / engine 12046 so retail Outlast accepts it.
echo Every other package keeps normal engine versioning.
echo.

echo [1/3] Checking the manifest
rem A mod with a manifest needs an Id, Name, Version and Author, and the Id must be
rem namespaced by the Author. Check before cooking, so that costs a second here rather
rem than a .u that compiles fine and then does not appear in the launcher.
rem Exit 2 means there is no manifest at all, which is fine for a non-SDK mod.
set NoManifest=
powershell -NoProfile -ExecutionPolicy Bypass -File "%EngineRoot%\MakeModSrcFiles\Check-ModManifest.ps1" -File "%~dp0Classes"
if ERRORLEVEL 2 (
    set NoManifest=1
) else if ERRORLEVEL 1 (
    exit /b 1
)
echo.

echo [2/3] Compiling scripts
rem The retail stamp is applied when the package is WRITTEN, so a package that make
rem considers up to date would keep its old stamp. Delete it first to force a rebuild.
if exist "%UPath%" del "%UPath%"

"%EngineRoot%\Binaries\Win64\OLGame.com" make -auto -NOPAUSEONSUCCESS -SaveAsRetail=%ModName%

if ERRORLEVEL 1 (
    echo.
    echo Failed to compile %ModName%. Fix the first error above, then run this again.
    exit /b 1
)

rem make also succeeds when it never built this package, which happens when the mod
rem is not registered with it. Check for the file rather than trusting the exit code.
if not exist "%UPath%" (
    echo.
    echo make finished, but it did not write OLGame\Script\%ModName%.u.
    echo %ModName% is probably not registered with make. From the engine root, run:
    echo   powershell -ExecutionPolicy Bypass -File MakeModSrcFiles\Register-Package.ps1 -EngineRoot . -Package OutlastSDK,%ModName%
    exit /b 1
)
echo.

echo [3/3] Checking the retail stamp
rem Without the Retail Package Patch the switch is ignored and make still succeeds,
rem so read the stamp back rather than assume it was applied.
powershell -NoProfile -ExecutionPolicy Bypass -File "%EngineRoot%\MakeModSrcFiles\Check-RetailFormat.ps1" -Package "%UPath%"
if ERRORLEVEL 1 (
    echo.
    echo The Retail Package Patch is not built into this engine, so -SaveAsRetail did nothing.
    echo Install the patch, rebuild the engine, then run this again.
    exit /b 1
)

echo.
for %%i in ("%UPath%") do echo Output: OLGame\Script\%ModName%.u, %%~zi bytes
echo Run Deploy.bat to package it for release.

if defined NoManifest (
    echo.
    echo Note: %ModName% has no SDKModManifest class, so it was built as a plain script package.
    echo That is fine for non-SDK mods, but the OutlastSDK needs a manifest to list and load a mod.
)
exit /b 0